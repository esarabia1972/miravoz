{
  "version": 2,
  "framework": null,
  "buildCommand": "node tools/build-offline-manifest.mjs --check",
  "outputDirectory": "web",
  "installCommand": "echo \"MiraVoz no tiene dependencias de producción\"",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/offline-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!vendor/|sw\\.js|offline-manifest\\.json).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}